<script type='text/javascript' id='cloudflare-turnstile-js-after'>
(function () {
	'use strict';

	var maxAttempts = 40;
	var observerStarted = false;

	function log() {
		if (!window.console || !document.documentElement.classList.contains('ovren-turnstile-debug')) {
			return;
		}

		var args = Array.prototype.slice.call(arguments);
		args.unshift('[OVREN Turnstile]');
		console.log.apply(console, args);
	}

	function isTurnstileReady() {
		return (
			typeof window.turnstile !== 'undefined' &&
			typeof window.turnstile.render === 'function'
		);
	}

	function renderTurnstileWidgets(scope, attempt) {
		attempt = attempt || 0;

		if (!isTurnstileReady()) {
			if (attempt < maxAttempts) {
				window.setTimeout(function () {
					renderTurnstileWidgets(scope, attempt + 1);
				}, 250);
			}
			return;
		}

		var root = scope && typeof scope.querySelectorAll === 'function'
			? scope
			: document;

		var widgets = root.querySelectorAll('.cf-turnstile');

		if (!widgets.length) {
			return;
		}

		widgets.forEach(function (el) {
			if (el.dataset.ovrenTurnstileRendered === '1') {
				return;
			}

			var siteKey = el.getAttribute('data-sitekey');

			if (!siteKey) {
				log('Widget ignoré : data-sitekey absent.', el);
				return;
			}

			try {
				var widgetId = window.turnstile.render(el, {
					sitekey: siteKey,
					theme: el.getAttribute('data-theme') || 'auto',
					appearance: el.getAttribute('data-appearance') || 'always'
				});

				el.dataset.ovrenTurnstileRendered = '1';

				if (typeof widgetId !== 'undefined') {
					el.dataset.ovrenTurnstileWidgetId = widgetId;
				}

				log('Widget rendu.', el);
			} catch (error) {
				log('Erreur de rendu.', error);
			}
		});
	}

	function resetTurnstileWidgets(scope) {
		if (!isTurnstileReady() || typeof window.turnstile.reset !== 'function') {
			return;
		}

		var root = scope && typeof scope.querySelectorAll === 'function'
			? scope
			: document;

		root.querySelectorAll('.cf-turnstile[data-ovren-turnstile-rendered="1"]').forEach(function (el) {
			var widgetId = el.dataset.ovrenTurnstileWidgetId;

			try {
				if (widgetId) {
					window.turnstile.reset(widgetId);
					log('Widget reset.', widgetId);
				}
			} catch (error) {
				log('Erreur de reset.', error);
			}
		});
	}

	function scheduleRender(delay, scope) {
		window.setTimeout(function () {
			renderTurnstileWidgets(scope || document);
		}, delay || 100);
	}

	function boot() {
		scheduleRender(100);
		scheduleRender(600);
		scheduleRender(1200);
		startObserver();
	}

	function startObserver() {
		if (observerStarted || typeof MutationObserver === 'undefined' || !document.documentElement) {
			return;
		}

		observerStarted = true;

		var observer = new MutationObserver(function (mutations) {
			var shouldRender = false;

			mutations.forEach(function (mutation) {
				if (!mutation.addedNodes || !mutation.addedNodes.length) {
					return;
				}

				mutation.addedNodes.forEach(function (node) {
					if (!node || node.nodeType !== 1) {
						return;
					}

					if (
						(node.classList && node.classList.contains('cf-turnstile')) ||
						(typeof node.querySelector === 'function' && node.querySelector('.cf-turnstile'))
					) {
						shouldRender = true;
					}
				});
			});

			if (shouldRender) {
				scheduleRender(150);
				scheduleRender(600);
			}
		});

		observer.observe(document.documentElement, {
			childList: true,
			subtree: true
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot);
	} else {
		boot();
	}

	window.addEventListener('load', function () {
		scheduleRender(100);
		scheduleRender(800);
	});

	/**
	 * Popups Elementor.
	 */
	if (window.jQuery) {
		window.jQuery(window).on('elementor/popup/show', function () {
			scheduleRender(150);
			scheduleRender(600);
			scheduleRender(1200);
		});

		/**
		 * Après une soumission Ajax Elementor, le token peut être consommé.
		 * On reset pour permettre une nouvelle tentative sans recharger la page.
		 */
		window.jQuery(document).ajaxComplete(function () {
			window.setTimeout(function () {
				resetTurnstileWidgets(document);
			}, 1000);
		});
	}

	document.addEventListener('elementor/popup/show', function () {
		scheduleRender(150);
		scheduleRender(600);
		scheduleRender(1200);
	});

	document.addEventListener('submit', function (event) {
		var form = event.target;

		if (!form || typeof form.querySelector !== 'function') {
			return;
		}

		if (!form.querySelector('.cf-turnstile')) {
			return;
		}

		window.setTimeout(function () {
			resetTurnstileWidgets(form);
		}, 3000);
	}, true);
})();
</script>
